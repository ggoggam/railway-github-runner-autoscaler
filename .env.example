# Copy to .env for local development. On Railway these are service variables.
#
# Note: Railway suggests variables from this file when you connect the repo.
# RAILWAY_PROJECT_ID and RAILWAY_ENVIRONMENT_ID are deliberately commented out —
# Railway injects both, and an explicit empty value would shadow the real one.

# --- Required ---
# Secret shared with the GitHub webhook (Settings -> Webhooks -> Secret).
GITHUB_WEBHOOK_SECRET=
# Railway API token: https://railway.com/account/tokens
RAILWAY_API_TOKEN=

# --- Runner service: name it or identify it ---
# Name of the runner service to scale, resolved within this project at startup.
# This is the default, and is what lets a template work without a service ID.
RAILWAY_RUNNER_SERVICE_NAME=Runner
# Optional override: an explicit service ID skips the name lookup entirely.
# RAILWAY_RUNNER_SERVICE_ID=

# --- Injected by Railway; set these only when running locally ---
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=

# --- Optional ---
# Every label here must be present on a job for it to be counted.
RUNNER_LABELS=self-hosted,railway
# Upper bound on concurrent runner replicas.
MAX_RUNNERS=3
# Replicas kept warm while idle. 0 means scale to zero.
MIN_REPLICAS=0
# Wait this long after the last job event before shrinking the pool.
IDLE_COOLDOWN=60s
# After a restart, hold existing replicas this long before any scale-down.
STARTUP_GRACE=5m
# Drop jobs whose completion webhook never arrived.
JOB_TTL=6h
# How often to retry failed scales and expire stale jobs.
RESYNC_PERIOD=30s
# Reconcile against GitHub so a lost webhook or a dead pool self-heals.
# Needs repo scope, or Administration:read + Actions:read.
GITHUB_API_TOKEN=
# owner/repo to reconcile against. Required with GITHUB_API_TOKEN.
GITHUB_API_REPOSITORY=
# How long a pool may hold replicas with no live runner before being recycled.
RUNNER_GRACE=3m
# Pin the region instead of discovering it (e.g. us-west2).
RAILWAY_RUNNER_REGION=
# debug | info | warn | error
LOG_LEVEL=info
PORT=8080
